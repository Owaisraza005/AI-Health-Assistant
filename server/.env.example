# Copy this file to .env and fill in your values.

# Optional. If left empty, the server automatically uses a smart rule-based
# conversation engine instead, so the app still works end-to-end with zero config.
OPENAI_API_KEY=

# Optional. Defaults to gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini

# Port the Express server listens on.
PORT=5050
